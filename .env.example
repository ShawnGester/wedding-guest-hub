# Each environment needs its own free Supabase project.
# Run supabase/schema.sql in BOTH projects (SQL editor), then copy each
# project's URL and anon/publishable key into the matching file below.
# These files are gitignored. Do not put real keys in a shared .env —
# Vite loads .env for every mode, including production builds.

# .env.development — npm run dev (local / dev database)
VITE_SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-dev-anon-key

# .env.production — npm run build / npm run deploy (production database)
# Leave empty until the production project exists. Empty values keep
# cloud sync off instead of falling back to the dev project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
